<%- include('partials/header') %>
  <main id="main-content" class="container">
    <h1><%= title %></h1>
    <p class="lead">Groups that organize and support service projects.</p>
    <section class="card-grid">
      <article class="card">
        <img src="/images/green-earth.svg" alt="Green Earth Alliance logo, a leaf over a globe" width="400" height="240">
        <h2>Green Earth Alliance</h2>
        <p>Cleans up parks and rivers, and plants trees across the region.</p>
      </article>
      <article class="card">
        <img src="/images/bright-futures.svg" alt="Bright Futures Foundation logo, an open book with a star" width="400" height="240">
        <h2>Bright Futures Foundation</h2>
        <p>Offers tutoring and school supplies to students in need.</p>
      </article>
      <article class="card">
        <img src="/images/helping-hands.svg" alt="Helping Hands Network logo, two hands holding a heart" width="400" height="240">
        <h2>Helping Hands Network</h2>
        <p>Connects volunteers with neighbors who need practical help.</p>
      </article>
    </section>
  </main>
<%- include('partials/footer') %>
