<%- include('partials/header') %>
  <main id="main-content" class="container">
    <section class="hero">
      <h1><%= title %></h1>
      <p class="lead">Find local organizations and service projects that make a difference, and see where you can help.</p>
    </section>
    <section class="card-grid">
      <article class="card">
        <h2>Organizations</h2>
        <p>Meet the groups leading service work in our community.</p>
        <a class="button" href="/organizations">View organizations</a>
      </article>
      <article class="card">
        <h2>Projects</h2>
        <p>Browse current and upcoming service projects.</p>
        <a class="button" href="/projects">View projects</a>
      </article>
      <article class="card">
        <h2>Categories</h2>
        <p>Explore projects by the kind of help they provide.</p>
        <a class="button" href="/categories">View categories</a>
      </article>
    </section>
  </main>
<%- include('partials/footer') %>
