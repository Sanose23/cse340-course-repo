<%- include('partials/header') %>
<main tabindex="-1" id="main-content" class="container directory-main account-page">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Register</span></nav>
  <header class="page-heading"><p class="eyebrow">Join the service network</p><h1><%= title %></h1><p>Create an account to access your personal dashboard.</p></header>
  <form class="editor-form" action="/register" method="POST">
    <p class="form-note" id="registration-help">All fields are required. Passwords must contain 7 to 72 bytes.</p>
    <div class="form-group"><label for="name">Name</label><input type="text" id="name" name="name" minlength="2" maxlength="100" required value="<%= formData.name || '' %>" autocomplete="name"></div>
    <div class="form-group"><label for="email">Email (Username)</label><input type="email" id="email" name="email" maxlength="100" required value="<%= formData.email || '' %>" autocomplete="email"></div>
    <div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" minlength="7" maxlength="72" required autocomplete="new-password" aria-describedby="registration-help"></div>
    <div class="button-group"><button class="button button-primary" type="submit">Register</button><a class="button button-secondary" href="/login">I already have an account</a></div>
  </form>
</main>
<%- include('partials/footer') %>
