<form class="editor-form" action="<%= formAction %>" method="POST">
  <p class="form-note">All fields are required. Project titles must contain 3 to 200 characters.</p>
  <div class="form-group">
    <label for="title">Project Title</label>
    <input type="text" id="title" name="title" maxlength="200" required value="<%= formData.title || '' %>" autocomplete="off">
  </div>
  <div class="form-group">
    <label for="description">Description</label>
    <textarea id="description" name="description" maxlength="500" required rows="6"><%= formData.description || '' %></textarea>
  </div>
  <div class="form-group">
    <label for="location">Location</label>
    <input type="text" id="location" name="location" maxlength="200" required value="<%= formData.location || '' %>" autocomplete="street-address">
  </div>
  <div class="form-group">
    <label for="date">Date</label>
    <input type="date" id="date" name="date" required value="<%= formData.date || '' %>">
  </div>
  <div class="form-group">
    <label for="organizationId">Organization</label>
    <select id="organizationId" name="organizationId" required>
      <option value="">Select an organization</option>
      <% for (const organization of organizations) { %>
        <option value="<%= organization.organization_id %>" <%= String(formData.organizationId || '') === String(organization.organization_id) ? 'selected' : '' %>><%= organization.name %></option>
      <% } %>
    </select>
  </div>
  <div class="button-group">
    <button class="button button-primary" type="submit"><%= submitLabel %></button>
    <a class="button button-secondary" href="<%= cancelPath %>">Cancel</a>
  </div>
</form>
