<%- include('partials/header') %>
<main tabindex="-1" id="main-content">
  <section class="hero container" aria-labelledby="welcome-heading">
    <div class="hero-copy">
      <h1 class="eyebrow"><%= title %></h1>
      <h2 id="welcome-heading" class="hero-title">Welcome to the <span>CSE 340<br>Service Network!</span></h2>
      <p class="hero-description">Our mission is to promote service across the world by connecting volunteers with service opportunities in their community.</p>
      <div class="button-group">
        <a class="button button-primary" href="/projects">Explore service projects <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/organizations">Meet our partners</a>
      </div>
      <p class="hero-note"><span class="status-dot" aria-hidden="true"></span> A little time can make a lasting difference.</p>
    </div>
    <figure class="network-visual">
      <div class="visual-label"><span class="status-dot" aria-hidden="true"></span> Better, together</div>
      <svg class="network-lines" viewBox="0 0 480 380" aria-hidden="true"><path d="M240 140 L95 270 M240 140 L240 270 M240 140 L385 270" /></svg>
      <div class="network-core"><img class="main-logo" src="/images/cse340-service-network.png" alt="CSE 340 Service Network Logo" width="350" height="154"></div>
      <div class="network-partners">
        <% for (const organization of organizations) { %>
          <a href="/organization/<%= organization.organization_id %>" class="network-node"><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" width="100" height="100"><span><%= organization.name.split(' ')[0] %></span></a>
        <% } %>
      </div>
      <figcaption>Connecting people with places to serve.</figcaption>
    </figure>
  </section>

  <section class="discover-section" aria-labelledby="discover-heading">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Find your way to give back</p><h2 id="discover-heading">Every interest has a place.</h2></div>
        <a class="text-link" href="/categories">Explore all categories <span aria-hidden="true">↗</span></a>
      </div>
      <div class="category-preview-grid">
        <% for (const [index, category] of categories.entries()) { %>
          <a class="category-preview accent-<%= ['green', 'blue', 'amber', 'rose'][index % 4] %>" href="/category/<%= category.category_id %>">
            <span class="category-number"><%= String(index + 1).padStart(2, '0') %></span>
            <h3><%= category.name %></h3><span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="container home-projects" aria-labelledby="projects-heading">
    <div class="section-heading"><div><p class="eyebrow">Start with something simple</p><h2 id="projects-heading">Good things start with showing up.</h2></div><a class="text-link" href="/projects">View service projects <span aria-hidden="true">↗</span></a></div>
    <div class="project-preview-list">
      <% for (const project of projects.slice(0, 3)) { %>
        <a href="/project/<%= project.project_id %>" class="project-preview"><span><%= project.organization_name %></span><h3><%= project.title %></h3><span class="card-arrow" aria-hidden="true">↗</span></a>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
